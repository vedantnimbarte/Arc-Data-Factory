# Copy to .env. All keys are prefixed ARC_ (see arc/core/config.py).
ARC_ENVIRONMENT=dev
ARC_LOG_JSON=true

ARC_POSTGRES_HOST=postgres
ARC_POSTGRES_PORT=5432
ARC_POSTGRES_USER=arc
ARC_POSTGRES_PASSWORD=arc
ARC_POSTGRES_DB=arc

# Split broker vs cache (avoids the single-Redis bottleneck).
ARC_REDIS_CACHE_URL=redis://redis-cache:6379/0
ARC_CELERY_BROKER_URL=redis://redis-broker:6379/0
ARC_CELERY_RESULT_BACKEND=redis://redis-broker:6379/1

ARC_S3_ENDPOINT_URL=http://minio:9000
ARC_S3_ACCESS_KEY=minioadmin
ARC_S3_SECRET_KEY=minioadmin
ARC_S3_BUCKET_RAW=arc-raw
ARC_S3_BUCKET_DATASETS=arc-datasets

# Ray: empty => local; set to ray://ray-head:10001 for a cluster.
ARC_RAY_ADDRESS=

# Security: comma-separated API keys (JSON list also accepted by pydantic).
ARC_API_KEYS=["dev-key-change-me"]
ARC_ALLOW_COLLECTOR_PRIVATE_RANGES=false

# Source credentials, keyed by a source's credential_ref (JSON map).
# Without a GitHub token the API allows only 60 requests/hour.
ARC_CREDENTIALS={}
